clc;
clear all;

msg = [1 0 1 1 0 1 0];

reg = [0 0 0];

for i = 1:length(msg)

    reg = [msg(i) reg(1:2)];

    out1 = mod(sum(reg),2);
    out2 = mod(reg(1)+reg(3),2);

    encoded(2*i-1) = out1;
    encoded(2*i) = out2;

end

disp('Input Sequence:');
disp(msg);

disp('Encoded Sequence:');
disp(encoded);
